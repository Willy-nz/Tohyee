# Copy to .env.local for development (never commit real values).

# Runtime database login. Its database is the "core" database (organisation
# registry, users, sessions). Organisation databases are created next to it.
# With `npm run db:start` this is:
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/tohyee

# Optional: a separate login with CREATEDB that owns organisation databases
# and runs migrations. When set, the runtime login above gets data access only.
# DATABASE_ADMIN_URL=postgresql://tohyee_admin:<password>@localhost:5432/tohyee

# Needed once, for first-time setup at /setup (16+ random characters).
# Setup stays locked while this is empty. Generate one with:
#   openssl rand -base64 24
SETUP_TOKEN=

# Encrypts secrets Tohyee stores, such as bank feed (Akahu) tokens: 32+ random
# characters. Bank feeds can't be set up without it. Keep it with your backups;
# changing it makes the saved tokens unreadable (enter them again).
#   openssl rand -base64 36
TOHYEE_SECRET_KEY=

# Optional settings
# TOHYEE_BANK_FEEDS_SCHEDULER=off        # don't sync bank feeds in the background
# TOHYEE_TIME_ZONE=Pacific/Auckland      # what "today" means for report defaults
# TOHYEE_COOKIE_SECURE=true              # force Secure cookies (auto-detected from HTTPS)
# TOHYEE_CORE_POOL_SIZE=10               # connections to the core database
# TOHYEE_ORG_POOL_SIZE=5                 # connections per organisation database
# TOHYEE_MAX_ORG_POOLS=25                # organisation pools kept open at once
# TOHYEE_ORG_DATABASE_PREFIX=tohyee_org_ # new organisation databases are <prefix><id>
#                                        # (default: <core database name>_org_)
# TOHYEE_SKIP_STARTUP_MIGRATIONS=1       # don't migrate on start (not recommended)

# For `npm test` (database tests). Needs a login that can CREATE DATABASE.
# TEST_DATABASE_URL=postgresql://app_user:app_password@localhost:5432/postgres

# Reserved for background jobs (not used yet).
# REDIS_URL=redis://localhost:6379
