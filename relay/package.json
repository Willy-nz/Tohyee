{
  "name": "tohyee-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Tohyee address: hands out Cloudflare Tunnel addresses to Tohyee servers. Runs as a Cloudflare Worker.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:setup": "wrangler d1 migrations apply tohyee-relay --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20260930.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  },
  "overrides": {
    "undici": "^7.30.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  }
}
